# --- Saida: Vercel -> n8n ---
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/vercel-integration-lab
N8N_OUTBOUND_SECRET=change-me-outbound-secret

# --- Entrada: n8n -> Vercel (callback assincrono) ---
VERCEL_CALLBACK_SECRET=change-me-callback-secret

# --- Persistencia dos callbacks (Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key
